# Copy to .env and adjust. Every setting is documented in src/journey_agent/config.py.

# --- LLM: any OpenAI-compatible server ----------------------------------------
# Ollama (default):          http://localhost:11434/v1   model e.g. qwen2.5:7b-instruct
# MLX (mlx_lm.server):       http://localhost:8080/v1    model e.g. mlx-community/Qwen2.5-7B-Instruct-4bit
JA_LLM_BASE_URL=http://localhost:11434/v1
JA_LLM_MODEL=qwen2.5:7b-instruct
JA_LLM_TEMPERATURE=0.1
JA_LLM_MAX_TOKENS=512

# --- Embeddings ------------------------------------------------------------------
JA_EMBEDDING_PROVIDER=fastembed
JA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Ingestion ---------------------------------------------------------------------
# auto = headless Chromium if installed (captures XHR payloads), else static HTTP fetch
JA_FETCH_MODE=auto
# SSRF guard. Only enable to ingest pages on localhost / your LAN during development.
JA_ALLOW_PRIVATE_URLS=false

# --- Guardrails & retrieval (calibrate with: uv run python -m journey_agent.evals evals/nubazo.json)
JA_RELEVANCE_THRESHOLD=0.55
# Cross-encoder relevance gate (~1 GB download on first start). Set to "" to use the cosine gate.
JA_RERANKER_MODEL=BAAI/bge-reranker-base
JA_RERANK_THRESHOLD=-4.65
# Below this a question is off-page regardless; between it and JA_RERANK_THRESHOLD the LLM
# input judge breaks the tie. FAISS proposes CANDIDATE_POOL x top_k chunks for the reranker.
JA_RERANK_HARD_THRESHOLD=-8.0
JA_CANDIDATE_POOL=3
# Question languages the reranker can judge; questions in other languages use the cosine gate.
JA_RERANKER_LANGUAGES=["English"]
# Languages the agent replies in. Detected from the visitor's message; the first is the default.
JA_REPLY_LANGUAGES=["English","Hindi"]
JA_GROUNDING_THRESHOLD=0.58
# With JA_LLM_GUARDRAILS on, embedding grounding only blocks below this floor; the LLM judge decides above it.
JA_GROUNDING_FLOOR=0.45
# LLM-as-judge checks on the message (pre) and the answer (post): 2 extra model calls per
# question (~2-6 s on a local 7B). The deterministic guardrails always run regardless.
JA_LLM_GUARDRAILS=true
# Lets the console edit the persona. Set false for anything customer-facing.
JA_ALLOW_PROMPT_OVERRIDE=true

# --- Server --------------------------------------------------------------------------
JA_HOST=127.0.0.1
JA_PORT=8000
# Origins serving frontend/ (CORS + snapshot frame-ancestors). Widget host sites need NOT be listed.
JA_FRONTEND_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
